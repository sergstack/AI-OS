{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-os/schemas/autoresearch_researcher_proposal.schema.json",
  "title": "AIOS AutoResearch v0.2 Bounded Researcher Proposal",
  "description": "One live Researcher proposal (issue #415, parent #409): one falsifiable hypothesis, one causal mechanism, one minimal reversible shadow patch to one mutable-surface file/anchor. Additive to v0.1 -- reuses schemas/autoresearch_experiment_record.schema.json's mutation/scope discipline by reference, does not modify it. A proposal is NOT a candidate: passing this schema and the deterministic preflight means only ready_for_experiment, never keep_candidate. The schema has NO field for candidate acceptance, authority, merge, production, or a numeric quality score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "researcher_invocation_id",
    "failure_id",
    "attribution_status",
    "falsifiable_hypothesis",
    "candidate_cause",
    "alternative_causes_considered",
    "minimal_discriminating_test",
    "mutation_class",
    "target_file",
    "target_anchor",
    "patch_text_or_ref",
    "patch_hash",
    "one_causal_mechanism_statement",
    "expected_effect",
    "affected_eval_families",
    "possible_downside",
    "required_checks",
    "rollback",
    "confidence",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "proposal_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{4,96}$" },
    "researcher_invocation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{4,128}$" },
    "failure_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{2,96}$" },
    "attribution_status": { "type": "string", "enum": ["supported", "uncertain", "rejected"] },
    "discriminating_experiment_only": {
      "description": "Set true (and required true) when attribution_status is 'uncertain': the proposal may only fund a labelled bounded discriminating experiment, not a confident fix.",
      "type": "boolean"
    },
    "falsifiable_hypothesis": { "type": "string", "minLength": 8 },
    "candidate_cause": { "type": "string", "minLength": 4 },
    "alternative_causes_considered": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "minimal_discriminating_test": { "type": "string", "minLength": 8 },
    "mutation_class": {
      "type": "string",
      "enum": ["wording_clarification", "ordering_adjustment", "tiebreak_rule_text", "context_priority_text"]
    },
    "target_file": { "type": "string", "minLength": 3 },
    "target_anchor": { "type": "string", "minLength": 1 },
    "patch_text_or_ref": { "type": "string", "minLength": 1 },
    "patch_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "one_causal_mechanism_statement": { "type": "string", "minLength": 8 },
    "expected_effect": { "type": "string", "minLength": 8 },
    "affected_eval_families": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["routing", "scope_execution", "evidence", "authority", "handoff", "adversarial"] }
    },
    "possible_downside": { "type": "string", "minLength": 8 },
    "required_checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "rollback": { "type": "string", "minLength": 8 },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "limitations": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "description": "An uncertain-attribution proposal may only fund a labelled bounded discriminating experiment (#415). A 'rejected' attribution never reaches this schema -- run_researcher returns before building a proposal.",
      "if": { "properties": { "attribution_status": { "const": "uncertain" } } },
      "then": {
        "required": ["discriminating_experiment_only"],
        "properties": { "discriminating_experiment_only": { "const": true } }
      }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["authority_status"] },
      { "required": ["merge_status"] },
      { "required": ["production_status"] },
      { "required": ["keep_candidate"] },
      { "required": ["quality_score"] },
      { "required": ["numeric_score"] }
    ]
  }
}
