{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-os/schemas/subagent_dispatch_evidence.schema.json",
  "title": "AI-OS Subagent Dispatch Evidence",
  "description": "Deterministic evidence record for the bounded 'Supervised AI-OS subagent dispatch (pilot)' commissioning. One entry per actually executed native subagent dispatch. This is NOT the AES execution record and does not change it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_for", "records"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_for": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dispatch_record" }
    }
  },
  "definitions": {
    "metric": {
      "description": "A captured non-negative number, or the literal string 'not_captured'. No other value is permitted: a missing runtime metric must be declared, never omitted or invented.",
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "const": "not_captured" }
      ]
    },
    "dispatch_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "execution_id",
        "owner_capability",
        "agent_type",
        "isolation",
        "workspace_observation",
        "outcome",
        "defect_ref",
        "telemetry",
        "scenario_tags"
      ],
      "properties": {
        "dispatch_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{2,64}$" },
        "execution_id": { "type": "string", "pattern": "^exec-[a-z0-9-]{3,64}$" },
        "owner_capability": { "type": "string", "pattern": "^[a-z_]{2,32}$" },
        "agent_type": { "type": "string", "enum": ["Plan", "Explore"] },
        "isolation": { "const": "worktree" },
        "workspace_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "clean_tree", "head"],
          "properties": {
            "path": { "type": "string", "pattern": "\\.claude/worktrees/agent-" },
            "clean_tree": {
              "oneOf": [{ "type": "boolean" }, { "const": "not_captured" }]
            },
            "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
          }
        },
        "outcome": { "type": "string", "enum": ["completed", "refused", "defect"] },
        "defect_ref": { "type": ["string", "null"], "minLength": 1 },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms", "subagent_tokens", "tool_uses"],
          "properties": {
            "duration_ms": { "$ref": "#/definitions/metric" },
            "subagent_tokens": { "$ref": "#/definitions/metric" },
            "tool_uses": { "$ref": "#/definitions/metric" }
          }
        },
        "scenario_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "routing",
              "deliberate_failure",
              "long_multi_hop",
              "repeat_route_guard",
              "patch_return_write",
              "runtime_reverify"
            ]
          }
        },
        "notes": { "type": "string" },
        "missing_required_knowledge": {
          "description": "Optional. Populated from the child's structured evidence (not narrative summary) when it observes a canonical_path or declared entrypoint/dependency referenced but absent. See docs/standards/BOUNDED_PROJECT_CONTEXT_FRESHNESS.md. Not required, so existing records need no backfill.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
